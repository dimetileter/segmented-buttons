<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SegmentedButtonBar Demo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- 1. Horizontal Style (2 Buttons) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horizontal Style (2 Buttons)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/horizontalBar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="2"
            app:sbButton1Text="Camera"
            app:sbButton2Text="Gallery"
            android:layout_marginBottom="20dp" />

        <!-- 2. Horizontal Style (3 Buttons) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horizontal Style (3 Buttons)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/horizontalBar3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="3"
            app:sbButton1Text="All"
            app:sbButton2Text="Favorites"
            app:sbButton3Text="Archived"
            android:layout_marginBottom="20dp" />

        <!-- 3. Vertical Style (3 Buttons) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vertical Style (3 Buttons)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/verticalBar3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="vertical"
            app:sbButtonCount="3"
            android:layout_marginBottom="20dp" />

        <!-- 4. Circular Style (Single Button) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Circular Style (24dp Button)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/circularBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="circular"
            android:layout_marginBottom="20dp" />

        <!-- 5. Pill Style (Next Button) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pill Style (Next Action)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/pillNextBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="pill"
            app:sbPillType="next"
            android:layout_marginBottom="20dp" />

        <!-- Status Output -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>