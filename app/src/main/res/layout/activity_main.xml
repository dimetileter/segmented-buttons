<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SegmentedButtonBar Demo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- 1. Horizontal Style (Text-Only, Centered) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Horizontal Style (Text-Only / Centered)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/horizontalBarTextOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="3"
            app:sbButton1Text="Day"
            app:sbButton2Text="Week"
            app:sbButton3Text="Month"
            android:layout_marginBottom="20dp" />

        <!-- 2. Hybrid Style (2 Horizontal + 1 Circular 32x32dp Action Button) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Hybrid Style (2 Horizontal + 1 Circular 32x32)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/hybridBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="3"
            app:sbButton1Text="Active"
            app:sbButton2Text="Completed"
            app:sbButton3Style="circular"
            app:sbButton3Icon="@drawable/ic_sb_arrow_next"
            android:layout_marginBottom="20dp" />

        <!-- 3. Horizontal Style (Icon + Text) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Horizontal Style (Icon + Text)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/horizontalBarIconText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="2"
            app:sbButton1Icon="@drawable/ic_sb_arrow_back"
            app:sbButton1Text="Previous"
            app:sbButton2Icon="@drawable/ic_sb_arrow_next"
            app:sbButton2Text="Next"
            android:layout_marginBottom="20dp" />

        <!-- 4. Vertical Style (3 Buttons) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Vertical Style (3 Buttons)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/verticalBar3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="vertical"
            app:sbButtonCount="3"
            app:sbButton1Icon="@drawable/ic_sb_arrow_next"
            app:sbButton2Icon="@drawable/ic_sb_arrow_back"
            app:sbButton3Icon="@drawable/ic_sb_arrow_next"
            android:layout_marginBottom="20dp" />

        <!-- 5. Circular Style (Single Button) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5. Circular Style (24dp Button)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/circularBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="circular"
            app:sbButton1Icon="@drawable/ic_sb_arrow_next"
            android:layout_marginBottom="20dp" />

        <!-- 6. Expandable Animated Style -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6. Expandable Animated Style"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/expandableBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="expandable"
            app:sbButtonCount="3"
            app:sbButton1Icon="@drawable/ic_sb_arrow_next"
            app:sbButton2Icon="@drawable/ic_sb_arrow_back"
            app:sbButton3Icon="@drawable/ic_sb_arrow_next"
            android:layout_marginBottom="20dp" />

        <!-- 7. Pill Style (Next Button) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7. Pill Style (Next Action)"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/pillNextBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="pill"
            app:sbPillType="next"
            android:layout_marginBottom="20dp" />

        <!-- Status Output -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>