<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- 0. TabBar Style with Sliding Pill Indicator -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_tab"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/tabBarDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="tab"
            app:sbButtonCount="3"
            app:sbButton1Text="Home"
            app:sbButton2Text="Explore"
            app:sbButton3Text="Profile"
            android:layout_marginBottom="20dp" />

        <!-- 1. 5-Button Bar with Hybrid Circular & Icon Tint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_five_button"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/fiveButtonBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="5"
            app:sbButton1Icon="@drawable/ic_sb_arrow_back"
            app:sbButton2Icon="@drawable/ic_sb_arrow_next"
            app:sbButton3Icon="@drawable/ic_sb_arrow_back"
            app:sbButton4Icon="@drawable/ic_sb_arrow_next"
            app:sbButton5Style="circular"
            app:sbButton5Icon="@drawable/ic_sb_arrow_next"
            android:layout_marginBottom="20dp" />

        <!-- 2. Horizontal Style (Text-Only, Centered) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_text_only"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/horizontalBarTextOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="3"
            app:sbButton1Text="Day"
            app:sbButton2Text="Week"
            app:sbButton3Text="Month"
            android:layout_marginBottom="20dp" />

        <!-- 3. Hybrid Style (2 Horizontal + 1 Circular 32x32dp) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_hybrid"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/hybridBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="3"
            app:sbButton1Text="Active"
            app:sbButton2Text="Completed"
            app:sbButton3Style="circular"
            app:sbButton3Icon="@drawable/ic_sb_arrow_next"
            android:layout_marginBottom="20dp" />

        <!-- 4. Horizontal Style (Icon + Text) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_icon_text"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/horizontalBarIconText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sbStyle="horizontal"
            app:sbButtonCount="2"
            app:sbButton1Icon="@drawable/ic_sb_arrow_back"
            app:sbButton1Text="Previous"
            app:sbButton2Icon="@drawable/ic_sb_arrow_next"
            app:sbButton2Text="Next"
            android:layout_marginBottom="20dp" />

        <!-- 5. Vertical Style (3 Buttons) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_vertical"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/verticalBar3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="vertical"
            app:sbButtonCount="3"
            app:sbButton1Icon="@drawable/ic_sb_arrow_next"
            app:sbButton2Icon="@drawable/ic_sb_arrow_back"
            app:sbButton3Icon="@drawable/ic_sb_arrow_next"
            android:layout_marginBottom="20dp" />

        <!-- 6. Expandable Animated Style (Horizontal & Vertical) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_expandable"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
                android:id="@+id/expandableBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:sbStyle="expandable"
                app:sbButtonCount="3"
                app:sbCollapseOnSelect="true"
                app:sbExpandDirection="end"
                app:sbButton1Icon="@drawable/ic_sb_arrow_next"
                app:sbButton2Icon="@drawable/ic_sb_arrow_back"
                app:sbButton3Icon="@drawable/ic_sb_arrow_next"
                android:layout_marginEnd="16dp" />

            <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
                android:id="@+id/expandableVerticalBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:sbStyle="expandable"
                app:sbButtonCount="3"
                app:sbCollapseOnSelect="true"
                app:sbExpandDirection="down"
                app:sbButton1Icon="@drawable/ic_sb_arrow_next"
                app:sbButton2Icon="@drawable/ic_sb_arrow_back"
                app:sbButton3Icon="@drawable/ic_sb_arrow_next" />
        </LinearLayout>

        <!-- 7. Pill Style (Next Button) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_pill"
            android:layout_marginBottom="8dp" />

        <com.dimetileter.segmentedbuttonbar.SegmentedButtonBar
            android:id="@+id/pillNextBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sbStyle="pill"
            app:sbPillType="next"
            app:sbPillActivated="true"
            android:layout_marginBottom="20dp" />

        <!-- Status Output -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_ready"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
