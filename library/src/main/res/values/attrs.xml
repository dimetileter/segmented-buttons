<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      SegmentedButtonBar Custom Attributes
      SegmentedButtonBar Özel XML Nitelikleri
    -->
    <declare-styleable name="SegmentedButtonBar">
        <!-- Layout style / Düzen stili -->
        <attr name="sbStyle" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
            <enum name="circular" value="2" />
            <enum name="pill" value="3" />
            <enum name="expandable" value="4" />
            <enum name="tab" value="5" />
        </attr>

        <!-- Button count (1-6) / Buton sayısı -->
        <attr name="sbButtonCount" format="integer" />

        <!-- Automatic single-selection behavior / Otomatik seçim davranışı -->
        <attr name="sbAutoSelect" format="boolean" />

        <!-- Optional maximum bar width / İsteğe bağlı maksimum çubuk genişliği -->
        <attr name="sbMaxWidth" format="dimension" />

        <!-- Pill style action type / Pill stili eylem türü -->
        <attr name="sbPillType" format="enum">
            <enum name="next" value="0" />
            <enum name="back" value="1" />
            <enum name="text" value="2" />
        </attr>

        <!-- Expansion direction for expandable style / Genişleme yönü -->
        <attr name="sbExpandDirection" format="enum">
            <enum name="end" value="0" />
            <enum name="start" value="1" />
        </attr>

        <!-- Auto-collapse expandable bar after selecting a child button / Seçim sonrası otomatik daralma -->
        <attr name="sbCollapseOnSelect" format="boolean" />

        <!-- Sliding selection pill indicator animation toggle / Kayan seçim göstergesi animasyon anahtarı -->
        <attr name="sbSlideIndicator" format="boolean" />

        <!-- Sliding selection indicator animation duration in ms / Gösterge kayma animasyon süresi (ms) -->
        <attr name="sbIndicatorDuration" format="integer" />

        <!-- Bar elevation & shadow / Çubuk gölge ve yükseklik seviyesi -->
        <attr name="sbElevation" format="dimension" />

        <!-- Global icon tint / Genel ikon renk tonu -->
        <attr name="sbIconTint" format="color|reference" />

        <!-- Global all-activated toggle / Tüm butonların aktiflik durumunu tek ayarla belirleme -->
        <attr name="sbAllActivated" format="boolean" />

        <!-- Initial selection and activation states / Başlangıç seçim ve aktiflik durumları -->
        <attr name="sbSelectedIndex" format="integer" />
        <attr name="sbPillActivated" format="boolean" />

        <!-- Unselected button background control / Seçili olmayan buton arkaplan kontrolü -->
        <attr name="sbShowUnselectedBackground" format="boolean" />
        <attr name="sbUnselectedButtonColor" format="color|reference" />

        <!-- Custom Backgrounds, Colors, Gradients, Ripple and Bar Color / Özel Arkaplan, Renk, Gradyan, Dalgalanma ve Çubuk Rengi -->
        <attr name="sbSelectedBackground" format="reference" />
        <attr name="sbSelectedColor" format="color|reference" />
        <attr name="sbBarBackground" format="reference|color" />
        <attr name="sbBarColor" format="color|reference" />
        <attr name="sbRippleColor" format="color|reference" />

        <!-- Tooltip and Accessibility / Uzun Basma İpucu ve Erişilebilirlik -->
        <attr name="sbAutoTooltip" format="boolean" />

        <!-- Per-button individual styles for hybrid bars / Hibrit barlar için buton bazlı stiller -->
        <attr name="sbButton1Style" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="circular" value="1" />
            <enum name="pill" value="2" />
        </attr>
        <attr name="sbButton2Style" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="circular" value="1" />
            <enum name="pill" value="2" />
        </attr>
        <attr name="sbButton3Style" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="circular" value="1" />
            <enum name="pill" value="2" />
        </attr>
        <attr name="sbButton4Style" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="circular" value="1" />
            <enum name="pill" value="2" />
        </attr>
        <attr name="sbButton5Style" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="circular" value="1" />
            <enum name="pill" value="2" />
        </attr>
        <attr name="sbButton6Style" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="circular" value="1" />
            <enum name="pill" value="2" />
        </attr>

        <!-- Per-button resources, states, tooltips & custom backgrounds (1..6) -->
        <attr name="sbButton1Icon" format="reference" />
        <attr name="sbButton1Text" format="string" />
        <attr name="sbButton1IconTint" format="color|reference" />
        <attr name="sbButton1Selected" format="boolean" />
        <attr name="sbButton1Activated" format="boolean" />
        <attr name="sbButton1Enabled" format="boolean" />
        <attr name="sbButton1ContentDescription" format="string" />
        <attr name="sbButton1Tooltip" format="string" />
        <attr name="sbButton1SelectedBackground" format="reference" />
        <attr name="sbButton1SelectedColor" format="color|reference" />
        <attr name="sbButton1Background" format="reference" />

        <attr name="sbButton2Icon" format="reference" />
        <attr name="sbButton2Text" format="string" />
        <attr name="sbButton2IconTint" format="color|reference" />
        <attr name="sbButton2Selected" format="boolean" />
        <attr name="sbButton2Activated" format="boolean" />
        <attr name="sbButton2Enabled" format="boolean" />
        <attr name="sbButton2ContentDescription" format="string" />
        <attr name="sbButton2Tooltip" format="string" />
        <attr name="sbButton2SelectedBackground" format="reference" />
        <attr name="sbButton2SelectedColor" format="color|reference" />
        <attr name="sbButton2Background" format="reference" />

        <attr name="sbButton3Icon" format="reference" />
        <attr name="sbButton3Text" format="string" />
        <attr name="sbButton3IconTint" format="color|reference" />
        <attr name="sbButton3Selected" format="boolean" />
        <attr name="sbButton3Activated" format="boolean" />
        <attr name="sbButton3Enabled" format="boolean" />
        <attr name="sbButton3ContentDescription" format="string" />
        <attr name="sbButton3Tooltip" format="string" />
        <attr name="sbButton3SelectedBackground" format="reference" />
        <attr name="sbButton3SelectedColor" format="color|reference" />
        <attr name="sbButton3Background" format="reference" />

        <attr name="sbButton4Icon" format="reference" />
        <attr name="sbButton4Text" format="string" />
        <attr name="sbButton4IconTint" format="color|reference" />
        <attr name="sbButton4Selected" format="boolean" />
        <attr name="sbButton4Activated" format="boolean" />
        <attr name="sbButton4Enabled" format="boolean" />
        <attr name="sbButton4ContentDescription" format="string" />
        <attr name="sbButton4Tooltip" format="string" />
        <attr name="sbButton4SelectedBackground" format="reference" />
        <attr name="sbButton4SelectedColor" format="color|reference" />
        <attr name="sbButton4Background" format="reference" />

        <attr name="sbButton5Icon" format="reference" />
        <attr name="sbButton5Text" format="string" />
        <attr name="sbButton5IconTint" format="color|reference" />
        <attr name="sbButton5Selected" format="boolean" />
        <attr name="sbButton5Activated" format="boolean" />
        <attr name="sbButton5Enabled" format="boolean" />
        <attr name="sbButton5ContentDescription" format="string" />
        <attr name="sbButton5Tooltip" format="string" />
        <attr name="sbButton5SelectedBackground" format="reference" />
        <attr name="sbButton5SelectedColor" format="color|reference" />
        <attr name="sbButton5Background" format="reference" />

        <attr name="sbButton6Icon" format="reference" />
        <attr name="sbButton6Text" format="string" />
        <attr name="sbButton6IconTint" format="color|reference" />
        <attr name="sbButton6Selected" format="boolean" />
        <attr name="sbButton6Activated" format="boolean" />
        <attr name="sbButton6Enabled" format="boolean" />
        <attr name="sbButton6ContentDescription" format="string" />
        <attr name="sbButton6Tooltip" format="string" />
        <attr name="sbButton6SelectedBackground" format="reference" />
        <attr name="sbButton6SelectedColor" format="color|reference" />
        <attr name="sbButton6Background" format="reference" />
    </declare-styleable>
</resources>
