<?xml version="1.0" encoding="utf-8"?>
<!-- Single Vertical Button Item / Tekil Dikey Buton Öğesi -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sb_vertical_root"
    android:layout_width="@dimen/sb_vertical_button_width"
    android:layout_height="@dimen/sb_vertical_button_height"
    android:background="@drawable/state_segmented_button"
    android:foreground="?android:attr/selectableItemBackground"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <!-- Button Icon / Buton İkonu -->
    <ImageView
        android:id="@+id/sb_vertical_icon"
        android:layout_width="@dimen/sb_button_icon_size"
        android:layout_height="@dimen/sb_button_icon_size"
        android:layout_gravity="center"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        tools:src="@drawable/ic_sb_arrow_next" />
</FrameLayout>
